; Engine configuration file.
; Timeline Restorer — Godot PoC (one scene: Franklin's workshop, Act 1).
; Godot 4.7.2-stable, GDScript only, Compatibility renderer, single-threaded web export.

config_version=5

[application]

config/name="Timeline Restorer — Godot PoC"
config/description="One-scene proof of concept: Franklin's workshop, Act 1, Philadelphia 1764."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.07, 0.05, 1)
